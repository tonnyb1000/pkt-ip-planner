! ==========================================================
! Cisco IOS Router Configuration Script (Generated by pkt-ip-planner)
! Copy and paste each section into the corresponding router CLI
! in Cisco Packet Tracer: CLI tab > enable > configure terminal
! ==========================================================

! ----------------------------------------------------------
! Router: R1
! ----------------------------------------------------------
enable
configure terminal
hostname R1
no ip domain-lookup
interface FastEthernet0/0
 description Subnet: LAN Alpha
 ip address 192.168.1.1 255.255.255.248
 no shutdown
 exit
interface FastEthernet0/1
 description Subnet: LAN Beta
 ip address 192.168.1.9 255.255.255.248
 no shutdown
 exit
exit
write memory
!
