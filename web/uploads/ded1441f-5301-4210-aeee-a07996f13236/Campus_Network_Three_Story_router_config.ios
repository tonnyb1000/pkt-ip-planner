write memory
!

! ----------------------------------------------------------
! Router: R3-LEVEL3
! ----------------------------------------------------------
enable
configure terminal
hostname R3-LEVEL3
no ip domain-lookup
interface GigabitEthernet0/1
 description Subnet: WAN Link (R1-LEVEL1-R3-LEVEL3)
 ip address 192.168.1.30 255.255.255.252
 no shutdown
 exit
interface GigabitEthernet0/0
 description Subnet: WAN Link (R2-LEVEL2-R3-LEVEL3)
 ip address 192.168.1.34 255.255.255.252
 no shutdown
 exit
interface GigabitEthernet0/2
 description Subnet: LAN 6 (R3-LEVEL3 GigabitEthernet0/2)
 ip address 192.168.1.1 255.255.255.248
 no shutdown
 exit
! Static Routing for Inter-Subnet Communication:
 ip route 192.168.1.24 255.255.255.252 192.168.1.29
 ip route 192.168.1.8 255.255.255.248 192.168.1.29
