! ==========================================================
! Cisco IOS Router Configuration Script (Generated by pkt-ip-planner)
! Copy and paste each section into the corresponding router CLI
! in Cisco Packet Tracer: CLI tab > enable > configure terminal
! ==========================================================

! ----------------------------------------------------------
! Router: R1-LEVEL1
! ----------------------------------------------------------
enable
configure terminal
hostname R1-LEVEL1
no ip domain-lookup
interface GigabitEthernet0/0
 description Subnet: WAN Link (R1-LEVEL1-R2-LEVEL2)
 ip address 192.168.1.33 255.255.255.252
 no shutdown
 exit
interface GigabitEthernet0/1
 description Subnet: WAN Link (R1-LEVEL1-R3-LEVEL3)
 ip address 192.168.1.37 255.255.255.252
 no shutdown
 exit
interface GigabitEthernet0/2
 description Subnet: LAN 9 (R1-LEVEL1 GigabitEthernet0/2)
 ip address 192.168.1.49 255.255.255.252
 no shutdown
 exit
! Static Routing for Inter-Subnet Communication:
 ip route 192.168.1.40 255.255.255.252 192.168.1.34
 ip route 192.168.1.52 255.255.255.252 192.168.1.34
 ip route 192.168.1.56 255.255.255.252 192.168.1.38
exit
write memory
!

